DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=malinalli_pairing
DB_USER=malinalli_pairing
DB_PASSWORD=REPLACE_WITH_A_RANDOM_DATABASE_PASSWORD
PROCESS_B_TOKEN=REPLACE_WITH_A_RANDOM_PROCESS_B_TOKEN
# Select the deployed harness; never accept this value from HTTP input.
AGENT_RUNTIME=hermes
AGENT_SSH_USER=agent_user
AGENT_SSH_HOST=127.0.0.1
AGENT_SSH_PORT=22
# Optional when the PHP service cannot use the agent user's default SSH key.
# AGENT_SSH_IDENTITY_FILE=/var/lib/malinalli/.ssh/id_ed25519
# Fixed absolute paths or PATH-resolved commands on the SSH target.
HERMES_BIN=hermes
OPENCLAW_BIN=openclaw
# Required for Process B: the main session to resume/target.
HERMES_SESSION=SESSION_ID_OR_KEY
# OPENCLAW_SESSION_KEY=agent:main:telegram:direct:...
