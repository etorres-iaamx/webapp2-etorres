WEBAPP2_DB_HOST=127.0.0.1
WEBAPP2_DB_PORT=3306
WEBAPP2_DB_NAME=webapp2_pairing
WEBAPP2_DB_USER=webapp2_pairing
WEBAPP2_DB_PASSWORD=REPLACE_WITH_A_RANDOM_DATABASE_PASSWORD
WEBAPP2_PROCESS_B_TOKEN=REPLACE_WITH_A_RANDOM_PROCESS_B_TOKEN
# Select the deployed harness; never accept this value from HTTP input.
WEBAPP2_RUNTIME=hermes
WEBAPP2_SSH_USER=agent_user
WEBAPP2_SSH_HOST=127.0.0.1
WEBAPP2_SSH_PORT=22
# Optional when the PHP service cannot use the agent user's default SSH key.
# WEBAPP2_SSH_IDENTITY_FILE=/var/lib/webapp2/.ssh/id_ed25519
# Fixed absolute paths or PATH-resolved commands on the SSH target.
WEBAPP2_HERMES_BIN=hermes
WEBAPP2_OPENCLAW_BIN=openclaw
# Required for Process B: the main session to resume/target.
WEBAPP2_HERMES_SESSION=SESSION_ID_OR_KEY
# WEBAPP2_OPENCLAW_SESSION_KEY=agent:main:telegram:direct:...
